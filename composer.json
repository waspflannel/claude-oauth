{
    "name": "waspflannel/claude-oauth",
    "description": "Run the local Claude Code CLI headless with a subscription OAuth token and get validated structured JSON back.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {"name": "Jaden"}
    ],
    "require": {
        "php": "^8.2",
        "symfony/process": "^6.4|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0|^10.0"
    },
    "suggest": {
        "laravel/framework": "Auto-discovered service provider and publishable config"
    },
    "autoload": {
        "psr-4": {"Waspflannel\\ClaudeOAuth\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Waspflannel\\ClaudeOAuth\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["Waspflannel\\ClaudeOAuth\\Laravel\\ClaudeOAuthServiceProvider"]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
